# Copie para .env e preencha. Nunca commite .env real.

# ── Geral
NODE_ENV=development
TZ=America/Sao_Paulo

# ── Database
DATABASE_URL=postgresql://clinica:clinica123@localhost:5432/clinica_psicologia?schema=public
REDIS_URL=redis://localhost:6379

# ── API
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
JWT_ACCESS_SECRET=troque-este-secret-min-32-chars-access
JWT_REFRESH_SECRET=troque-este-secret-min-32-chars-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Criptografia de campo (32 bytes hex = 64 chars)
# Gere com: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_HMAC_PEPPER=troque-este-pepper-para-hash-de-cpf

# ── Storage (R2 / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=sa-east-1
S3_BUCKET=clinica-documentos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── E-mail
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@clinica.app

# ── WhatsApp (Meta Cloud API ou Z-API)
WHATSAPP_PROVIDER=fake
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_TOKEN=xxx
WHATSAPP_PHONE_NUMBER_ID=xxx

# ── Pagamentos
PAYMENT_PROVIDER=fake
EFI_CLIENT_ID=xxx
EFI_CLIENT_SECRET=xxx
EFI_PIX_KEY=sua-chave-pix
EFI_SANDBOX=true
MERCADOPAGO_ACCESS_TOKEN=xxx

# ── Video
VIDEO_PROVIDER=daily
DAILY_API_KEY=xxx

# ── Observabilidade
SENTRY_DSN=
