# ==============================================================================
# ClínicaPsi — Variáveis de Ambiente (EXEMPLO)
# ==============================================================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o arquivo .env — ele já está no .gitignore.
# Gere secrets com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ==============================================================================

# ── Geral ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
TZ=America/Sao_Paulo

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://clinica:SUA_SENHA_POSTGRES@localhost:5432/clinica_psicologia?schema=public
# Redis connection string
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# ── JWT (mínimo 32 caracteres cada) ──────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=SEU_JWT_ACCESS_SECRET_AQUI_MIN_32_CHARS
JWT_REFRESH_SECRET=SEU_JWT_REFRESH_SECRET_AQUI_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Criptografia de campo (32 bytes hex = 64 chars) ──────────────────────────
# ⚠️  Gere suas próprias chaves: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA use valores de exemplo em produção!
ENCRYPTION_MASTER_KEY=SUA_CHAVE_MESTRE_64_CHARS_HEX_AQUI
ENCRYPTION_HMAC_PEPPER=SEU_HMAC_PEPPER_AQUI_MIN_8_CHARS

# ── Storage (MinIO / S3) ─────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=sa-east-1
S3_BUCKET=clinica-documentos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── E-mail (Brevo / Sendinblue) ──────────────────────────────────────────────
# Obter chave em: https://app.brevo.com/settings/smtp/api
BREVO_API_KEY=SUA_CHAVE_BREVO_AQUI
EMAIL_FROM=noreply@seudominio.com.br

# ── Notificações (Telegram Bot) ──────────────────────────────────────────────
# Criar bot via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=SEU_TOKEN_TELEGRAM_AQUI

# ── Pagamentos (Pix estático) ────────────────────────────────────────────────
# Chave Pix da clínica (CPF, email, telefone ou aleatória/EVP)
PIX_KEY=sua-chave-pix-aqui
PIX_RECEIVER_NAME=Nome Da Clinica
PIX_RECEIVER_CITY=Sao Paulo

# ── Telehealth (Jitsi Meet self-hosted) ──────────────────────────────────────
JITSI_DOMAIN=localhost:8443

# ── Observabilidade (Sentry) ─────────────────────────────────────────────────
SENTRY_DSN=